# Configuração local carregada pelo Next.js. Copie para .env.local e preencha. Não versionar o .env.local.
# Origem pública sem caminho. Rebuild obrigatório após alterações.
SITE_URL=https://higienizacaofritz.vercel.app
# Use false somente em ambientes que não devem ser indexados.
SITE_INDEXABLE=true
GOOGLE_SITE_VERIFICATION=
META_DOMAIN_VERIFICATION=

# Sem IDs inventados. Ativar somente após configurar contas e política.
NEXT_PUBLIC_TRACKING_ENABLED=false
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_PRIVACY_URL=
